# Backend
APP_NAME=Auto_Upt
APP_ENV=development
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://auto_upt:auto_upt@localhost:5432/auto_upt

# Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI
# OpenAI-compatible endpoint. DeepSeek example: https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Valid DeepSeek models: deepseek-chat, deepseek-reasoner
# Valid OpenAI models: gpt-4o, gpt-4o-mini
OPENAI_MODEL=deepseek-chat

# Playwright
BROWSER_HEADLESS=false
SCREENSHOT_DIR=storage/screenshots

# Storage
ASSET_STORAGE_DIR=storage/assets
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Credential encryption
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# WeChat Official Account
WECHAT_API_BASE_URL=https://api.weixin.qq.com

# Bilibili Web Login / Member APIs
# B站账号使用 passport 密码登录获取 Cookie 凭据，不再依赖开放平台 Client ID/Secret。
BILIBILI_PASSPORT_BASE=https://passport.bilibili.com
BILIBILI_MEMBER_BASE=https://member.bilibili.com
BILIBILI_API_BASE_URL=https://api.bilibili.com
BILIBILI_PREUPLOAD_PATH=/x/vu/client/preupload
BILIBILI_COVER_UPLOAD_PATH=/x/vu/client/cover/up
BILIBILI_VIDEO_SUBMIT_PATH=/x/vu/client/add
BILIBILI_VIDEO_STATUS_PATH=/x/vu/client/archive/status
BILIBILI_VIDEO_DELETE_PATH=/x/vu/client/archive/delete

# Local frontend CORS
# Vite 默认使用 5173；端口被占用时常自动切换到 5174-5179。
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|\[::1\]|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2}):\d+$
